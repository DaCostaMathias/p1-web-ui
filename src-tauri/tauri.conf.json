{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Persona Save Studio",
  "version": "0.1.0",
  "identifier": "dev.local.persona-save-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Persona Save Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Browser-only Persona 1 save editor and converter.",
    "longDescription": "Load, decrypt, edit, convert, and re-encrypt Persona 1 PC, PSP, and PS1 save files entirely on your machine."
  }
}
